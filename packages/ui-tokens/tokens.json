{
  "$description": "Design tokens shared across web (Tailwind) and mobile (Flutter) — see docs/Design.md §2–§4, §9. Source of truth is apps/web/src/styles/tokens.css; keep this file in sync manually when that changes.",
  "color": {
    "neutral": {
      "950": "#14121A",
      "800": "#2B2733",
      "500": "#6E6779",
      "200": "#E7E3EE",
      "50": "#FBFAFE"
    },
    "iridescent": {
      "violet": "#8B5CF6",
      "magenta": "#EC4899",
      "coral": "#FB7185",
      "amber": "#FBBF24",
      "mint": "#34D399",
      "cyan": "#22D3EE",
      "azure": "#60A5FA"
    },
    "semantic": {
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F43F5E",
      "info": "#60A5FA"
    }
  },
  "gradient": {
    "iridescent": {
      "angle": 120,
      "stops": [
        { "color": "#8B5CF6", "offset": 0 },
        { "color": "#EC4899", "offset": 0.25 },
        { "color": "#FB7185", "offset": 0.45 },
        { "color": "#FBBF24", "offset": 0.65 },
        { "color": "#34D399", "offset": 0.85 },
        { "color": "#22D3EE", "offset": 1 }
      ]
    },
    "events": { "angle": 120, "stops": [{ "color": "#8B5CF6", "offset": 0 }, { "color": "#EC4899", "offset": 1 }] },
    "schedules": { "angle": 120, "stops": [{ "color": "#22D3EE", "offset": 0 }, { "color": "#60A5FA", "offset": 1 }] },
    "achievements": { "angle": 120, "stops": [{ "color": "#FBBF24", "offset": 0 }, { "color": "#FB7185", "offset": 1 }] },
    "gallery": { "angle": 120, "stops": [{ "color": "#34D399", "offset": 0 }, { "color": "#22D3EE", "offset": 1 }] }
  },
  "radius": {
    "lg": 24,
    "md": 12
  },
  "typography": {
    "fontFamily": {
      "display": ["Clash Display", "system-ui", "sans-serif"],
      "body": ["Inter", "General Sans", "system-ui", "sans-serif"]
    },
    "scale": {
      "display": { "size": 56, "lineHeight": 1.05, "weight": 700 },
      "h1": { "size": 40, "lineHeight": 1.1, "weight": 700 },
      "h2": { "size": 30, "lineHeight": 1.2, "weight": 600 },
      "h3": { "size": 24, "lineHeight": 1.3, "weight": 600 },
      "bodyLg": { "size": 18, "lineHeight": 1.6, "weight": 400 },
      "body": { "size": 16, "lineHeight": 1.6, "weight": 400 },
      "caption": { "size": 14, "lineHeight": 1.4, "weight": 500 }
    }
  }
}
