# Docs — tidak di-track di git (permintaan user)
# Anchored to repo root so this doesn't also catch apps/api/docs/ (generated
# OpenAPI spec, which we DO want tracked).
*.md
/docs/

# Env / secrets
.env
.env.local
.env.*.local
!.env.example

# Node / web
node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/playwright-report/
apps/web/test-results/
apps/web/*.tsbuildinfo

# Go / api
apps/api/tmp/
apps/api/*.exe
apps/api/coverage.out

# Flutter / mobile
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/**/ios/Pods/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
