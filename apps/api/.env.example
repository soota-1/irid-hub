# Copy file ini jadi `.env` lalu isi dengan value asli.
# JANGAN PERNAH commit file `.env` (sudah masuk .gitignore) — lihat docs/Rules.md §6.

# --- Server ---
PORT=8080
ENV=local                       # local | staging | production

# --- Database (Neon) — docs/Architecture.md §5 ---
# Ambil dari dashboard Neon > Connection Details (gunakan pooled connection string).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth (Clerk) — docs/Schema.md §2.2 ---
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SIGNING_SECRET=   # untuk verifikasi webhook user.created/user.updated

# --- Object Storage (Cloudflare R2, S3-compatible) — docs/Architecture.md §1, §11 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_S3_ENDPOINT=                 # https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=                  # base URL publik (custom domain / r2.dev) untuk render aset galeri

# --- CORS — docs/Architecture.md §11 ---
CORS_ALLOWED_ORIGINS=http://localhost:5173  # pisahkan dengan koma untuk multi-origin (web prod, mobile scheme)

# --- Rate limiting (endpoint publik seperti form pendaftaran) ---
RATE_LIMIT_REQUESTS_PER_MINUTE=10
